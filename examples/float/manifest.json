{
  "id": "relink-float",
  "name": "Relink 浮岛",
  "version": "0.3.3",
  "apiVersion": 2,
  "entry": "index.html",
  "description": "黑白浮岛：音乐封面、同步歌词、播放控制、通话与频道切换，游戏时自动贴顶。",
  "capabilities": [
    "voice.read",
    "voice.mute",
    "voice.deafen",
    "app.show",
    "window.resize",
    "music.read",
    "music.control",
    "music.lyrics",
    "channels.read",
    "channels.switch"
  ],
  "author": {
    "name": "Nightsuzu",
    "avatar": "author.png"
  },
  "settings": [
    {
      "key": "followSystemMotion",
      "label": "跟随系统动画设置（关闭后启用完整动画）",
      "type": "toggle",
      "default": true
    },
    {
      "key": "orbit",
      "label": "环绕光效",
      "type": "toggle",
      "default": true
    },
    {
      "key": "notchTransparency",
      "label": "游戏刘海透明度（%）",
      "type": "range",
      "min": 0,
      "max": 85,
      "step": 5,
      "default": 15
    }
  ]
}
